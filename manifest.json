{
  "manifest_version": 3,
  "name": "1688聊天记录批量导出",
  "version": "1.1.4",
  "description": "一键批量导出1688客服聊天记录，支持日期筛选和AI格式",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "*://air.1688.com/*",
    "*://work.1688.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "1688聊天导出"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://air.1688.com/*", "*://work.1688.com/*"],
      "js": ["content/selectors.js", "content/content.js"],
      "css": ["content/inject.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
